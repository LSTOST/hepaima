generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  wechatOpenId  String?   @unique
  deviceIds     String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  initiatedSessions Session[] @relation("Initiator")
  joinedSessions    Session[] @relation("Partner")
}

model Session {
  id                  String        @id @default(cuid())
  inviteCode          String        @unique
  mode                TestMode      @default(STAGED)
  stage               Stage
  /// 专题量表测评标识（mode 为 SCENARIO 时使用）
  scenarioSlug        String?
  /// 第一幕个人自测子类型（mode 为 PERSONAL 时使用，如 trust_connect）
  personalSlug        String?
  status              SessionStatus @default(WAITING_PARTNER)

  productId           String
  product             Product       @relation(fields: [productId], references: [id])

  initiatorId         String?
  initiator           User?         @relation("Initiator", fields: [initiatorId], references: [id])
  initiatorDeviceId   String
  initiatorName       String
  initiatorAnswers    Json?
  initiatorCompletedAt DateTime?

  partnerId           String?
  partner             User?         @relation("Partner", fields: [partnerId], references: [id])
  partnerDeviceId     String?
  partnerName         String?
  partnerAnswers      Json?
  partnerCompletedAt  DateTime?

  result              Result?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  expiresAt           DateTime

  @@index([productId])
}

model Result {
  id                    String         @id @default(cuid())
  sessionId             String         @unique
  session               Session        @relation(fields: [sessionId], references: [id])

  overallScore          Int
  dimensions            Json

  initiatorTraits       Json?
  partnerTraits         Json?

  initiatorAttachment   AttachmentType
  partnerAttachment     AttachmentType

  initiatorLoveLanguage LoveLanguage
  partnerLoveLanguage   LoveLanguage

  reportBasic           Json?
  reportStandard        Json?
  reportPremium         Json?

  purchasedTier         ReportTier     @default(FREE)

  createdAt             DateTime       @default(now())
}

model Order {
  id            String         @id @default(cuid())
  resultId      String
  deviceId      String
  userId        String?

  tier          ReportTier
  amount        Int
  status        OrderStatus    @default(PENDING)
  promoCodeId   String?        // 若使用优惠码，支付成功后记入 PromoCodeUsage

  paymentMethod PaymentMethod?
  paymentId     String?
  paidAt        DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RedeemCode {
  id             String          @id @default(cuid())
  code           String          @unique // 兑换码，格式 HP-XXXX-XXXX
  batchId        String?         // 批次号
  usedByDeviceId String?
  firstUsedAt    DateTime?       // 首次使用时间
  createdAt      DateTime        @default(now())
  expiresAt      DateTime?       // 过期时间
  disabled       Boolean         @default(false)

  usages         RedeemCodeUsage[]
}

model RedeemCodeUsage {
  id           String     @id @default(cuid())
  redeemCodeId String
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id])
  stage        Stage      // UNIVERSAL / AMBIGUOUS / ROMANCE / STABLE
  sessionId    String?
  usedAt       DateTime   @default(now())

  @@unique([redeemCodeId, stage]) // 同一个码同一个阶段只能用一次
}

/// 优惠码：用于「解锁深度报告」时的折扣/免单，与兑换码（测评资格）分离
model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique // 如 HP9-XXXX-XXXX
  type      PromoType // FIXED_OFF | PERCENT_OFF | FREE_UNLOCK
  value     Int       // 固定减免(分) / 折扣1-99 / 0表免单
  maxUses   Int?      // 总使用次数上限，null 不限制
  usedCount Int       @default(0)
  expiresAt DateTime?
  disabled  Boolean   @default(false)
  batchId   String?
  createdAt DateTime  @default(now())

  usages PromoCodeUsage[]
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  resultId    String
  orderId     String?
  usedAt      DateTime  @default(now())

  @@index([promoCodeId])
}

/// 全局站点与品牌配置，通常只有一行（单租户场景）
model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("合拍吗")
  siteSubtitle    String   @default("基于心理学的关系测评工具")
  primaryColor    String   @default("#EC4899")
  secondaryColor  String   @default("#8B5CF6")
  logoUrl         String?  // 站点 Logo（相对路径或完整 URL）
  faviconUrl      String?  // 浏览器图标

  seoTitle        String?  // 全站默认 SEO 标题
  seoDescription  String?  // 全站默认 SEO 描述
  seoKeywords     String?  // 逗号分隔关键词
  ogImageUrl      String?  // 社交分享图

  icpRecord       String?  // 备案号
  footerHtml      String?  // 页脚富文本（可选）

  // 流量与埋点：第三方统计
  ga4MeasurementId String?   // Google Analytics 4 测量 ID，如 G-XXXXXXXXXX
  enableGa4       Boolean   @default(false)
  // Umami
  umamiScriptUrl  String?   // 如 https://umami.example.com/script.js
  umamiWebsiteId  String?   // data-website-id
  enableUmami     Boolean   @default(false)

  // Microsoft Clarity
  clarityProjectId String?  // clarity 的项目 id
  enableClarity    Boolean  @default(false)

  // 文档内容：可在后台自定义页面正文
  privacyContent   String?  // 隐私政策自定义内容（为空时使用内置文案）
  termsContent     String?  // 服务条款自定义内容
  contactContent   String?  // 联系我们页面自定义内容

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 自建访问/埋点事件（用于后台流量概览，PV/UV、关键事件）
model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String   // page_view | quiz_start | quiz_complete | result_view | pay_click 等
  path       String?  // 页面路径
  visitorId  String?  // 访客标识（用于 UV 去重）
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
}

/// 测评产品基础配置，不同测评（情侣、亲子、职业性格等）都在这里建一条记录
model Product {
  id              String   @id @default(cuid())
  slug            String   @unique // URL 标识，如 "couple-compatibility"
  name            String           // 产品名称，如「情侣契合度测试」
  shortDescription String?         // 简短一句话介绍

  coverImageUrl   String?          // 落地页主视觉
  icon            String?          // 可选：icon 名称或 URL

  themeConfigJson Json?            // UI 主题配置（主色、渐变、插画风格等）

  isActive        Boolean  @default(true)

  // SEO
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?

  // 定价（单位：分）
  priceCents      Int      @default(0)
  allowRedeemCode Boolean  @default(true)

  // 关联：一个产品可以有多套 AI 报告模板（不同语言/版本）
  aiTemplates     ProductAiTemplate[]
  questionnaires  Questionnaire[]
  traits          QuizTrait[]
  sessions        Session[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 每个产品对应的 AI 报告与模型配置
model ProductAiTemplate {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])

  modelName        String   @default("deepseek-chat") // 使用的模型名
  temperature      Float    @default(0.7)
  maxTokens        Int      @default(2048)

  systemPrompt     String   // 系统提示词
  userPromptTemplate String // 用户提示词模板（可包含占位符）
  sectionsJson     Json?    // 报告章节配置

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// 测评问卷（可以按产品 + 阶段拆分）
model Questionnaire {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  title       String
  stage       Stage?   // 对应 AMBIGUOUS / ROMANCE / STABLE / UNIVERSAL，可为空表示通用
  version     String?  // 版本号，便于灰度
  isActive    Boolean  @default(true)

  questions   QuizQuestion[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 题目定义，支持单选题、多选题、量表题等，通过 scoringJson 存储计分规则
model QuizQuestion {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])

  externalId      Int?          // 可选：对应现有代码中的题目 id
  order           Int           // 在问卷中的排序
  text            String        // 题干
  category        String?       // 如 attachment / loveLanguage / values 等
  type            QuestionType  // 题型
  helpText        String?
  required        Boolean       @default(true)

  scoringJson     Json?         // 计分规则（与现有 questions / questions-universal 结构兼容的 JSON）

  options         QuizQuestionOption[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model QuizQuestionOption {
  id          String       @id @default(cuid())
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id])

  key         String       // 如 "A"、"B" 或 "1"..."7"
  text        String
  order       Int
  scoringJson Json?        // 针对该选项的计分配置

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([questionId, key])
}

/// 测评维度/特质，例如 attachment_secure、values_family 等
model QuizTrait {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  key         String   // 维度 key，如 attachment_secure
  name        String   // 展示名称，如「安全型依恋」
  description String?
  category    String?  // 可选：所属大类（attachment / values 等）
  icon        String?
  color       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, key])
}

/// 支付渠道与参数配置（微信/支付宝等）
model PaymentProviderConfig {
  id          String   @id @default(cuid())
  type        PaymentProviderType

  appId       String?
  mchId       String?
  apiKey      String?
  privateKey  String?
  publicKey   String?
  notifyUrl   String?

  isEnabled   Boolean  @default(false)
  isSandbox   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 页面级 SEO 配置，可按路径单独覆盖
model PageSeo {
  id           String   @id @default(cuid())
  path         String   @unique // 如 "/"、"/quiz"、"/result/[sessionId]"
  title        String?
  description  String?
  keywords     String?
  ogImageUrl   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 通用内容片段，如 Footer 关于文案等
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique // 标识，如 "footer_about"、"homepage_trust_section"
  type      ContentBlockType @default(RICH_TEXT)
  locale    String?          // 预留多语言，如 "zh-CN"
  content   String           // 文本或 JSON 字符串

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentProviderType {
  WECHAT
  ALIPAY
}

enum ContentBlockType {
  PLAIN_TEXT
  RICH_TEXT
  JSON
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  SCALE
}

enum TestMode {
  UNIVERSAL
  STAGED
  SCENARIO
  /// 进入关系前 · 个人自测（单人，无需对方）
  PERSONAL
}

enum Stage {
  UNIVERSAL
  AMBIGUOUS
  ROMANCE
  STABLE
}

enum SessionStatus {
  WAITING_PARTNER
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum AttachmentType {
  SECURE
  ANXIOUS
  AVOIDANT
  FEARFUL
}

enum LoveLanguage {
  WORDS
  TIME
  GIFTS
  SERVICE
  TOUCH
}

enum ReportTier {
  FREE
  STANDARD
  PREMIUM
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WECHAT
  ALIPAY
}

enum PromoType {
  FIXED_OFF   // 固定减免，value=金额(分)
  PERCENT_OFF // 折扣，value=1-99
  FREE_UNLOCK // 免单，value=0
}